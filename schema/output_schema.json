{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "riverpay/decision.schema.json",
  "title": "RiverPay exception decision",
  "description": "Rebuilt from the field list on the assignment page (output_schema.json was not attached as a file).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "decision",
    "reason_codes",
    "customer_message",
    "internal_case_note",
    "tools_used",
    "confidence",
    "requires_human"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^E[0-9]{3}$"},
    "decision": {
      "type": "string",
      "enum": [
        "AUTO_RESOLVE",
        "AUTO_NOTIFY",
        "AUTO_BLOCK",
        "ESCALATE_FRAUD_OPS",
        "ESCALATE_COMPLIANCE",
        "ESCALATE_TECH_OPS",
        "ESCALATE_RECONCILIATION",
        "ESCALATE_AGENT_NETWORK",
        "ESCALATE_DATA_QUALITY"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^R([1-9]|1[0-3])$"}
    },
    "customer_message": {"type": "string"},
    "internal_case_note": {"type": "string", "minLength": 1},
    "tools_used": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "lookup_customer",
          "lookup_transaction",
          "lookup_recent_transfers",
          "lookup_agent",
          "check_sanctions",
          "get_policy"
        ]
      },
      "uniqueItems": true
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "requires_human": {"type": "boolean"}
  }
}
